{
  "about": {
    "engine": "Vortex client 0.6.3, Vortex Studio 0.6.1",
    "language": "Luau",
    "notes": "Collected from the Lua bindings and editor autocomplete shipped in the Vortex binaries plus scripts from published community projects. Vortex mirrors a subset of the Roblox API. Anything missing here should be assumed missing in Vortex too, even if Roblox has it.",
    "unverified": "Entries flagged unverified are inferred from Roblox conventions or editor labels rather than seen in Vortex's script bindings. Test them before relying on them."
  },
  "globals": [
    {
      "name": "game",
      "kind": "property",
      "type": "DataModel",
      "description": "Root of the place. Use game:GetService(name) to reach services."
    },
    {
      "name": "workspace",
      "kind": "property",
      "type": "Workspace",
      "description": "Shortcut for game:GetService(\"Workspace\")."
    },
